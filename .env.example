# -------------------------
# Deployment (prod compose)
# -------------------------
DOMAIN=ideaforge.example.com
ACME_EMAIL=you@example.com
SEARXNG_SECRET=

# -------------------------
# Database
# -------------------------
DB_URL=jdbc:postgresql://localhost:5433/ideaforge
DB_USER=ideaforge
DB_PASSWORD=ideaforge
DB_POOL_SIZE=10
POSTGRES_DB=ideaforge
POSTGRES_USER=ideaforge
POSTGRES_PASSWORD=ideaforge
POSTGRES_PORT=5433
# Database URL used by the prod compose stack (inside the compose network)
DB_URL_PROD=jdbc:postgresql://postgres:5432/ideaforge

# -------------------------
# App
# -------------------------
PORT=8080
APP_BASE_URL=http://localhost:5173
FORWARD_HEADERS_STRATEGY=none
CORS_ALLOWED_ORIGINS=http://localhost:5173
SWAGGER_ENABLED=false

# Secrets: generate with `openssl rand -hex 32`. MUST be set in prod.
SESSION_PEPPER=
OTP_PEPPER=
IP_PEPPER=

# -------------------------
# Auth
# -------------------------
# Only honored in the dev profile; app refuses to start with it under prod.
DEV_FIXED_OTP=000000
SESSION_COOKIE_NAME=ideaforge_session
SESSION_COOKIE_SECURE=false
GOOGLE_CLIENT_ID=
TURNSTILE_ENABLED=true
# Dev: Cloudflare test keys pass locally. Prod: real keys from the Turnstile dashboard.
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# -------------------------
# Email (SMTP) — Mailpit in dev, any free SMTP provider in prod
# -------------------------
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=no-reply@ideaforge.local
MAIL_FROM_NAME=IdeaForge
EMAIL_ALLOWLIST=
EMAIL_MX_CHECK=true
DISPOSABLE_EMAIL_REFRESH=true

# -------------------------
# LLM (model/provider are config only; placeholders below)
# provider: anthropic | openai | gemini | ollama | openai-compatible
# -------------------------
IDEATION_PROVIDER=ollama
IDEATION_MODEL=llama3.1
SCORING_PROVIDER=ollama
SCORING_MODEL=llama3.1
CHAT_PROVIDER=ollama
CHAT_MODEL=llama3.1
FINALIZE_PROVIDER=ollama
FINALIZE_MODEL=llama3.1

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=

LLM_DAILY_BUDGET_USD=10
LLM_DEFAULT_INPUT_PRICE=0
LLM_DEFAULT_OUTPUT_PRICE=0

# -------------------------
# Research
# -------------------------
SEARXNG_BASE_URL=http://localhost:8088
SEARXNG_ENABLED=true
SEARXNG_PORT=8088
SEARXNG_SECRET=dev-searxng-secret-change-me
TRENDS_ENABLED=false

# -------------------------
# Credits
# -------------------------
CREDIT_RECONCILIATION_CRON=0 15 3 * * *
