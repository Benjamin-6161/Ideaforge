# Copy this file to .env (gitignored) and adjust.
#   - Docker Compose (dev infra and the prod stack) reads it.
#   - In the dev profile the backend also imports .env directly (repo root or
#     backend/.env), so `./mvnw spring-boot:run` picks up provider choices and
#     API keys without Docker.
# -------------------------
# Deployment (prod compose)
# -------------------------
DOMAIN=ideaforge.example.com
ACME_EMAIL=you@example.com
SEARXNG_SECRET=

# -------------------------
# Database
# -------------------------
DB_URL=jdbc:postgresql://localhost:5433/ideaforge
DB_USER=ideaforge
DB_PASSWORD=ideaforge
DB_POOL_SIZE=10
POSTGRES_DB=ideaforge
POSTGRES_USER=ideaforge
POSTGRES_PASSWORD=ideaforge
POSTGRES_PORT=5433
# Database URL used by the prod compose stack (inside the compose network)
DB_URL_PROD=jdbc:postgresql://postgres:5432/ideaforge

# -------------------------
# App
# -------------------------
PORT=8080
APP_BASE_URL=http://localhost:5173
FORWARD_HEADERS_STRATEGY=none
# Only needed when the browser calls the API on a *different* origin. Local dev
# uses the Vite proxy and remote testing uses a server-side rewrite, so both are
# same-origin: keep this empty unless you know you need direct cross-origin calls.
CORS_ALLOWED_ORIGINS=
# Prod only: the dev profile always serves the OpenAPI docs (needed by gen:api).
SWAGGER_ENABLED=false

# Secrets: generate with `openssl rand -hex 32`. MUST be set in prod.
SESSION_PEPPER=
OTP_PEPPER=
IP_PEPPER=

# -------------------------
# Auth
# -------------------------
# Only honored in the dev profile; app refuses to start with it under prod.
DEV_FIXED_OTP=000000
SESSION_COOKIE_NAME=ideaforge_session
SESSION_COOKIE_SECURE=false
GOOGLE_CLIENT_ID=
# Dev force-disables Turnstile (the dev profile ignores this). In prod set
# enabled=true plus real keys; Cloudflare test keys work locally if you ever
# enable it manually.
TURNSTILE_ENABLED=true
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# -------------------------
# Email (SMTP) — Mailpit in dev, any free SMTP provider in prod
# -------------------------
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=no-reply@ideaforge.local
MAIL_FROM_NAME=IdeaForge
EMAIL_ALLOWLIST=
EMAIL_MX_CHECK=true
DISPOSABLE_EMAIL_REFRESH=true

# -------------------------
# LLM (config only; no code changes to switch providers)
# provider: anthropic | openai | gemini | deepseek | ollama | openai-compatible
#
# Set one pair per purpose (ideation, scoring, chat, finalize). Commented-out
# lines are ignored, so the backend falls back to its dev default
# (ollama / llama3.1). In dev the backend imports this file automatically
# (repo root or backend/.env); it does not need Docker.
#
#   OpenAI:    IDEATION_PROVIDER=openai    IDEATION_MODEL=<model>        + OPENAI_API_KEY
#   DeepSeek:  IDEATION_PROVIDER=deepseek  IDEATION_MODEL=deepseek-chat + DEEPSEEK_API_KEY
#   Anthropic: IDEATION_PROVIDER=anthropic IDEATION_MODEL=<model>       + ANTHROPIC_API_KEY
#   Gemini:    IDEATION_PROVIDER=gemini    IDEATION_MODEL=<model>       + GEMINI_API_KEY
#   Ollama:    IDEATION_PROVIDER=ollama    IDEATION_MODEL=<pulled model> (no key)
#   Custom:    IDEATION_PROVIDER=openai-compatible IDEATION_MODEL=<model>
#              + OPENAI_COMPATIBLE_BASE_URL / OPENAI_COMPATIBLE_API_KEY
#
# A cheaper SCORING_* model is recommended (scoring also powers deep
# validation). CHAT_* and FINALIZE_* can use different models or the same one.
#
# Example: DeepSeek for everything
# IDEATION_PROVIDER=deepseek
# IDEATION_MODEL=deepseek-chat
# SCORING_PROVIDER=deepseek
# SCORING_MODEL=deepseek-chat
# CHAT_PROVIDER=deepseek
# CHAT_MODEL=deepseek-chat
# FINALIZE_PROVIDER=deepseek
# FINALIZE_MODEL=deepseek-chat

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=

LLM_DAILY_BUDGET_USD=10
LLM_DEFAULT_INPUT_PRICE=0
LLM_DEFAULT_OUTPUT_PRICE=0

# -------------------------
# Research
# -------------------------
SEARXNG_BASE_URL=http://localhost:8088
SEARXNG_ENABLED=true
SEARXNG_PORT=8088
SEARXNG_SECRET=dev-searxng-secret-change-me
TRENDS_ENABLED=false

# -------------------------
# Credits
# -------------------------
CREDIT_RECONCILIATION_CRON=0 15 3 * * *
